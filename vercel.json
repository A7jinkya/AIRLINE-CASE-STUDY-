{
  "functions": {
    "api/passengers.js": {
      "includeFiles": "data/**",
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
